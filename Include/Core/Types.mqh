#ifndef TYPES_MQH
#define TYPES_MQH

//+------------------------------------------------------------------+
//|                                                        Types.mqh |
//|                                    Elite XAUUSD Scalping Engine  |
//+------------------------------------------------------------------+
#property strict

#include "Constants.mqh"

//--- Signal generated by a strategy
struct STradeSignal
  {
   ENUM_STRATEGY_ID  strategyId;
   ENUM_SIGNAL_TYPE  signalType;
   double            confidence;    // 0 to 100
   double            suggestedPrice;
   double            suggestedSL;
   double            suggestedTP;
   string            comment;

   // Explicit constructor to prevent MQL5 garbage stack memory anomalies
   STradeSignal()
     {
      strategyId = STRATEGY_MANUAL;
      signalType = SIGNAL_NONE;
      confidence = 0.0;
      suggestedPrice = 0.0;
      suggestedSL = 0.0;
      suggestedTP = 0.0;
      comment = "";
     }
  };

//--- Current Market Environment
struct SMarketEnvironment
  {
   ENUM_MARKET_REGIME regime;
   ENUM_SESSION       session;
   double             currentSpread;
   double             atrH1;
   double             atrM15;
   double             atrM5;
   bool               isSpreadHealthy;
   bool               isVolatilityHealthy;
   ENUM_TREND_DIRECTION trendDirection; // H1 macro bias
  };

//--- Risk profile configuration for a trade
struct SRiskProfile
  {
   double            riskPercent;
   double            maxDrawdownPercent;
   double            maxConsecutiveLosses;
  };

#endif
